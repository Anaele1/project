<!DOCTYPE html>
<html lang="en">
  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>patient_profile</title>
      <link rel='stylesheet', href='/stylesheets/style.css'> 
  </head>
  <body>

    <div class="users_wrapper">

      <!-- Header Section -->
      <header id="users_top">
          <%- include ('partials/header.ejs') %>
      </header>

      <!-- Nav Section -->
      <nav id="users_left">
          <ul>
              <li><a href="/patients/patient_dashboard">Dashboard</a></li>
              <li><a href="/patients/logout">Logout</a></li>
          </ul>
      </nav>

      <!-- Main Section -->
      <main id="users_container">

          <!-- Profile Modal -->
          <section id="profileModal" class="modal">
            <div class="modal-content">
              
              <h2>Your Profile</h2>
              <p><strong>First Name:</strong> <%= user.firstName %></p>
              <p><strong>Last Name:</strong> <%= user.lastName %></p>
              <p><strong>Email:</strong> <%= user.email %></p>
              
              <p>
                <!-- Language Form -->
                <form id="" action="/patients/update-language" method="POST">
                  <strong>Language:</strong>
                  <input type="hidden" name="patientId" value="<%= user.id %>">
                  <input type="text" name="language" placeholder="<%= user.language || 'Not set' %>" required>
                  <button id="" type="submit">Update Language</button>
                </form>
              </p>

              <p>
              <!-- Edit Specialty Form -->
              <form id="" action="/patients/update-location" method="POST">
                <strong>Location:</strong>
                  <input type="hidden" name="patientId" value="<%= user.id %>">
                  <input type="text" name="location" placeholder="<%= user.location || 'Not set' %>" required>
                  <button id="" type="submit">Update Location</button>
              </form>
              </p>

              <!-- Delete Account Link -->
              <p>
                <button style="border: none; color: red; font-size: 1rem;" class="delete-account" onclick="confirmDeleteAccount()">Delete Account</button>
              </p>

              <!-- Delete Account Form (hidden, triggered by JS) -->
              <form id="deleteAccountForm" action="/patients/delete-account" method="POST" style="display: none;">
                <input type="hidden" name="patientId" value="<%= user.id %>">
                <p>Are you sure you want to delete your account? This action cannot be undone.</p>
                <button type="submit" style="background-color: red;">Confirm Delete</button>
                <button type="button" onclick="cancelDeleteAccount()" style="background-color: gray;">Cancel</button>
              </form>
            </div>
          </section>

      </main>

      <!-- Footer Section -->
      <footer id="users_footer">
          <%- include ('partials/footer.ejs') %>
      </footer>
    </div>

    <script src="/javascripts/main.js"></script>
    
  </body>
</html>