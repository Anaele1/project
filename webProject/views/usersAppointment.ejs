<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' href='/stylesheets/style.css'>
    <title>Manage Appointments</title>
    
    <style>
      
      .hide {
        display: none;
      }

    </style>

  </head>
  <body>
    <main>
        <!-- top section -->
        <div class="top">
            <header>
            <%- include ('partials/header.ejs') %>
            </header>
        </div>

        <!-- Users header -->
        <div class="cHeader">

          <a href="/patients/patient_dashboard">Dashboard</a><br><br>
          <a href="/patients/providers_list">View Providers</a>
          <a href="/patients/appointment_history">Appointment History</a>
          <a href="/patients/appointments?status=pending" class="<%= status === 'pending' ? 'active' : '' %>">Pending Appointments</a>
          <a href="/patients/appointments?status=accepted" class="<%= status === 'accepted' ? 'active' : '' %>">Accepted Appointments</a>
          <a href="/patients/appointments?status=cancelled" class="<%= status === 'cancelled' ? 'active' : '' %>">Cancelled Appointments</a>
          
        </div>

        <!-- container section -->
        <div class="container">

          <!-- Providers list -->
          <ul id="providersList" class="<%= type !== 'providerss' ? 'hide' : '' %>" >
            <h2>Available Providers</h2>
            <% if (typeof providers !== 'undefined' && providers.length) { %>
              <% providers.forEach(provider => { %>
                <li>
                  <% if (provider.availability === 'online') { %>
                    <span class="online-label" style="background-color: green; color: white; border-radius: 3rem;">Online</span>
                  <% } else { %>
                    <span class="offline-label" style="background-color: grey; color: white; border-radius: 3rem;">Offline</span>
                  <% } %>
                  <%= provider.first_name %> <%= provider.last_name %> <i><b><%= provider.specialty %></b></i> 
                  <form action="/patients/book" method="POST">
                    <input type="hidden" name="providerId" value="<%= provider.provider_id %>">
                    <input type="date" name="date" required>
                    <input type="time" name="time" required>
                    <button type="submit">Book Appointment</button>
                  </form>
                </li>
              <% }); %>
              <% } else { %>
              <li>No providers available.</li>
            <% } %>
          </ul>

          <!-- Appointment status filter -->
          <div id="appointmentStatus" class="<%= type !== 'appointmentss' ? 'hide' : '' %>">
            <h2><%= status.charAt(0).toUpperCase() + status.slice(1) %> Appointments</h2>
            <% if (appointments.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                          <th>Availability</th>
                          <th>Patient Name</th>
                          <th>Appointment Date</th>
                          <th>Appointment Time</th>
                          <th>Status</th>
                          <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% appointments.forEach(appointment => { %>
                            <tr>
                                <td><% if (appointment.provider_availability === 'online') { %>
                                  <span class="online-label" style="background-color: green; color: white; border-radius: 3rem;">Online</span>
                                  <% } else { %>
                                  <span class="offline-label" style="background-color: grey; color: white; border-radius: 3rem;">Offline</span>
                                  <% } %>
                                </td>
                                <!-- <td><%= appointment.provider_availability %></td> -->
                                <td><%= appointment.provider_first_name %> <%= appointment.provider_last_name %></td>
                                <td><%= appointment.appointment_date %></td>
                                <td><%= appointment.appointment_time %></td>
                                <td><%= appointment.status %></td>
                                <td class="action-links">
                                    <% if (appointment.status === 'pending') { %>
                                        <form action="/patients/respond" method="POST">
                                          <input type="hidden" name="appointmentId" value="<%= appointment.appointment_id %>">
                                          <button type="submit" name="action" value="accept">Accept</button>
                                          <button type="submit" name="action" value="cancel">Cancel</button>
                                        </form>
                                    <% } else if (appointment.status === 'accepted') { %>
                                        <form action="/patients/respond" method="POST">
                                          <input type="hidden" name="appointmentId" value="<%= appointment.appointment_id %>">
                                          <button><a href="/chat/<%= appointment.appointment_id %>">Chat</a></button>
                                          <button type="submit" name="action" value="cancel">Cancel</button>
                                        </form>
                                    <% } else if (appointment.status === 'cancelled') { %>
                                        <form action="/patients/respond" method="POST">
                                          <input type="hidden" name="appointmentId" value="<%= appointment.appointment_id %>">
                                          <button type="submit" name="action" value="accept">Re-Accept</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No <%= status %> appointments found.</p>
            <% } %>
          </div>

        </div>

        <!-- Footer Section -->
        <footer>
        <%- include ('partials/footer.ejs') %>
        </footer>
    </main>

  </body>
</html>



