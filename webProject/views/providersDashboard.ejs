<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel='stylesheet', href='/stylesheets/style.css'>
  <title>provider dashboard</title>
 
</head>
  <body>
    <main>
      <div class="users_wrapper">

        <!--users top section -->
        <div id="users_top">
          <header><%- include ('partials/header.ejs') %></header>
          <b>WELCOME TO PROVIDER DASHBOARD</b>
        </div>

        <!-- users left section -->
        <div id="users_left">
          <a href="/providers/appointments">Appointments</a><br><br>
          <a href="/providers/providerProfile">Profile</a><br><br>
          <a href="/">Report</a><br><br><br>
          <!-- Logout Link -->
          <a href="/providers/logout">Logout</a>

        </div>

        <!-- users container -->
        <div id="users_container">

          <!-- Users details -->
          <div>
            <!-- <b>Availability: <%= user.availability %></b> -->
            <span class="online-label" style="background-color: green; color: white; border-radius: 3rem;">Online</span> 
            <h1>Welcome, <%= user.firstName %></h1>
            <b>Specialty: <%= user.specialty %></b>
          </div><br>
         

          <!-- Dashboard Views -->
          <div class="dViews" id="dv">
            
              <div class="dViewsList">
                <h3>Pending Appointments</h3>
                <p><%= statCounts.pending %></p>
                <a href="/providers/appointments?status=pending" class="<%= status === 'pending' ? 'active' : '' %>">View Pending</a>
              </div>

              <div class="dViewsList">
                <h3>Accepted Appointments</h3>
                <p><%= statCounts.accepted %></p>
                <a href="/providers/appointments?status=accepted" class="<%= status === 'accepted' ? 'active' : '' %>">View Accepted</a>
              </div>

              <div class="dViewsList">
                <h3>Cancelled Appointments</h3>
                <p><%= statCounts.cancelled %></p>
                <a href="/providers/appointments?status=cancelled" class="<%= status === 'cancelled' ? 'active' : '' %>">Cancelled Appointments</a>
              </div>

              <div class="dViewsList">
                <h3>Your Patients</h3>
                <p><%= patientCount %></p>
                <a href="/providers/myProviders">view Your Patients</a>
              </div>
          </div>

        
        </div>

        <!-- users footer -->
        <div id="users_footer"><%- include ('partials/footer.ejs') %></div>
      </div>
    </main>

    
    <script src="/javascripts/main.js"></script>

  </body>
</html>